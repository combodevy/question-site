{
  "name": "question-site",
  "version": "3.0.0",
  "description": "Online Question Bank & Smart Study Platform (Monorepo + Hono + SQLite)",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace=@qs/shared && npm run typecheck --workspace=@qs/api && npm run typecheck --workspace=@qs/web",
    "dev:api": "npm run dev --workspace=@qs/api",
    "build:api": "npm run build --workspace=@qs/api",
    "test:api": "npm run test --workspace=@qs/api",
    "dev:web": "npm run dev --workspace=@qs/web",
    "build:web": "npm run build --workspace=@qs/web",
    "test:web": "npm run test --workspace=@qs/web",
    "migrate:v2": "npm run migrate:v2 --workspace=@qs/api",
    "deploy:worker": "node scripts/check-deploy-target.mjs && cd worker && npx wrangler deploy",
    "deploy:pages": "node scripts/stage-pages.mjs && npx wrangler pages deploy .pages-dist --project-name question-site-front --commit-dirty",
    "deploy": "npm run deploy:worker && npm run deploy:pages",
    "dev:worker": "cd worker && npx wrangler dev",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --watch",
    "ci:data": "python3 scripts/audit-data.py",
    "ci:keys": "node scripts/validate-keys.mjs",
    "ci:i18n": "node scripts/check-i18n.mjs",
    "ci:dom": "node scripts/check-dom-contract.mjs",
    "ci:render": "node scripts/sweep-papers.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/combodevy/question-site.git"
  },
  "author": "combodevy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/combodevy/question-site/issues"
  },
  "homepage": "https://github.com/combodevy/question-site#readme",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
